# 로컬 MySQL 데이터베이스
MYSQL_DATABASE=yufesta
# 로컬 MySQL root 계정 비밀번호
MYSQL_ROOT_PASSWORD=yufesta
# Docker에서 외부로 노출할 API 서버 포트
APP_PORT=8080

JWT_SECRET=

# 카카오 개발자 콘솔에서 발급받은 REST API 키
KAKAO_CLIENT_ID=
# 카카오 로그인 토큰 교환에 사용하는 Client Secret
KAKAO_CLIENT_SECRET=

# Google Cloud Console에서 발급받은 OAuth 클라이언트 ID
GOOGLE_CLIENT_ID=
# Google Cloud Console에서 발급받은 OAuth 클라이언트 보안 비밀번호
GOOGLE_CLIENT_SECRET=

# 프론트엔드 주소(Vite 개발 서버). CORS 허용 origin이자 로그인 후 리다이렉트 기준. 127.0.0.1이 아니라 localhost로 연다
FRONTEND_URL=http://localhost:5173
# CORS 허용 origin 목록(쉼표 구분). 비우면 FRONTEND_URL 하나만. 예: http://localhost:5173,https://yufesta-web.vercel.app
ALLOWED_ORIGINS=

# 운영 환경에서 프론트와 API가 같은 상위 도메인을 공유하면 .yufesta.com처럼 입력
AUTH_COOKIE_DOMAIN=

# 회차 자동 오픈·마감·발표 스케줄러. 수동 API로만 회차를 다루고 싶으면 false
SCHEDULER_ENABLED=true
