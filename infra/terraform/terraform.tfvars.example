# terraform.tfvars로 복사해서 채운다(파일은 git에 올리지 않음).
# db_password는 여기 쓰지 말고 셸에서: export TF_VAR_db_password='...'
alarm_email = "you@example.com"

# 계정에 GitHub OIDC 공급자가 이미 있으면(apply에서 EntityAlreadyExists) 기존 것을 참조한다
# create_github_oidc_provider = false

# 축제 전에는 운영 Swagger를 끈다
# swagger_enabled = false

# 도메인·origin 기본값은 variables.tf. 바꿀 때만 적는다.
# 프론트가 로컬(5173)에서 운영 API의 공개 읽기 API를 호출하려면 아래처럼 localhost를 더한다. 축제 전에는 뺀다
# allowed_origins = ["https://yufesta.com", "https://www.yufesta.com", "https://yufesta-web.vercel.app", "http://localhost:5173"]
