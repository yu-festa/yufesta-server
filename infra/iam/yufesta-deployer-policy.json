{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "ReadOnlyDiscovery",
      "Effect": "Allow",
      "Action": [
        "ec2:Describe*",
        "elasticloadbalancing:Describe*",
        "ecs:Describe*",
        "ecs:List*",
        "ecr:Describe*",
        "ecr:List*",
        "ecr:GetAuthorizationToken",
        "rds:Describe*",
        "rds:ListTagsForResource",
        "logs:Describe*",
        "logs:ListTagsForResource",
        "cloudwatch:Describe*",
        "cloudwatch:ListTagsForResource",
        "sns:Get*",
        "sns:List*",
        "acm:Describe*",
        "acm:List*",
        "acm:GetCertificate",
        "route53:Get*",
        "route53:List*",
        "kms:DescribeKey",
        "kms:ListAliases",
        "ssm:DescribeParameters",
        "sts:GetCallerIdentity",
        "iam:Get*",
        "iam:List*"
      ],
      "Resource": "*"
    },
    {
      "Sid": "CreateAndManageProjectResources",
      "Effect": "Allow",
      "Action": [
        "ec2:*",
        "elasticloadbalancing:*",
        "ecs:*",
        "ecr:*",
        "rds:*",
        "logs:*",
        "cloudwatch:*",
        "sns:*",
        "acm:*"
      ],
      "Resource": "*"
    },
    {
      "Sid": "DenyChangingResourcesWithoutProjectTag",
      "Effect": "Deny",
      "Action": [
        "ec2:Delete*",
        "ec2:Modify*",
        "ec2:Terminate*",
        "ec2:Detach*",
        "ec2:Disassociate*",
        "ec2:Revoke*",
        "ec2:Authorize*",
        "ec2:CreateRoute",
        "ec2:ReplaceRoute",
        "ec2:AssociateRouteTable",
        "ec2:AttachInternetGateway",
        "elasticloadbalancing:Delete*",
        "elasticloadbalancing:Modify*",
        "elasticloadbalancing:Set*",
        "elasticloadbalancing:Deregister*",
        "elasticloadbalancing:RemoveTags",
        "ecs:Delete*",
        "ecs:Update*",
        "ecs:Deregister*",
        "ecs:StopTask",
        "ecs:UntagResource",
        "ecr:Delete*",
        "ecr:PutImage",
        "ecr:PutLifecyclePolicy",
        "ecr:PutImageTagMutability",
        "ecr:PutImageScanningConfiguration",
        "ecr:InitiateLayerUpload",
        "ecr:UploadLayerPart",
        "ecr:CompleteLayerUpload",
        "ecr:BatchDeleteImage",
        "ecr:SetRepositoryPolicy",
        "rds:Delete*",
        "rds:Modify*",
        "rds:Reboot*",
        "rds:Stop*",
        "rds:Start*",
        "rds:RemoveTagsFromResource",
        "logs:DeleteLogGroup",
        "logs:PutRetentionPolicy",
        "logs:DeleteRetentionPolicy",
        "logs:UntagResource",
        "cloudwatch:DeleteAlarms",
        "cloudwatch:DisableAlarmActions",
        "cloudwatch:EnableAlarmActions",
        "cloudwatch:SetAlarmState",
        "cloudwatch:UntagResource",
        "sns:DeleteTopic",
        "sns:SetTopicAttributes",
        "sns:UntagResource",
        "acm:DeleteCertificate",
        "acm:RemoveTagsFromCertificate",
        "elasticloadbalancing:CreateListener",
        "elasticloadbalancing:CreateRule",
        "elasticloadbalancing:RegisterTargets",
        "elasticloadbalancing:AddListenerCertificates",
        "rds:CreateDBSnapshot",
        "rds:CopyDBSnapshot",
        "rds:RestoreDBInstanceFromDBSnapshot",
        "ecs:RunTask",
        "ecs:StartTask"
      ],
      "Resource": "*",
      "Condition": {
        "StringNotEquals": {
          "aws:ResourceTag/Project": "yufesta"
        }
      }
    },
    {
      "Sid": "ProjectRolesOnly",
      "Effect": "Allow",
      "Action": [
        "iam:CreateRole",
        "iam:DeleteRole",
        "iam:UpdateRole",
        "iam:UpdateAssumeRolePolicy",
        "iam:TagRole",
        "iam:UntagRole",
        "iam:PassRole",
        "iam:AttachRolePolicy",
        "iam:DetachRolePolicy",
        "iam:PutRolePolicy",
        "iam:DeleteRolePolicy"
      ],
      "Resource": "arn:aws:iam::*:role/yufesta-*"
    },
    {
      "Sid": "ServiceLinkedRolesIfMissing",
      "Effect": "Allow",
      "Action": "iam:CreateServiceLinkedRole",
      "Resource": "*",
      "Condition": {
        "StringEquals": {
          "iam:AWSServiceName": [
            "ecs.amazonaws.com",
            "elasticloadbalancing.amazonaws.com",
            "rds.amazonaws.com"
          ]
        }
      }
    },
    {
      "Sid": "ProjectParametersOnly",
      "Effect": "Allow",
      "Action": [
        "ssm:PutParameter",
        "ssm:DeleteParameter",
        "ssm:GetParameter",
        "ssm:GetParameters",
        "ssm:GetParametersByPath",
        "ssm:AddTagsToResource",
        "ssm:RemoveTagsFromResource",
        "ssm:ListTagsForResource",
        "ssm:LabelParameterVersion"
      ],
      "Resource": "arn:aws:ssm:ap-northeast-2:*:parameter/yufesta/*"
    },
    {
      "Sid": "ProjectHostedZoneRecordsOnly",
      "Effect": "Allow",
      "Action": [
        "route53:ChangeResourceRecordSets",
        "route53:ListResourceRecordSets"
      ],
      "Resource": "arn:aws:route53:::hostedzone/<HOSTED_ZONE_ID>"
    },
    {
      "Sid": "TerraformStateBucket",
      "Effect": "Allow",
      "Action": [
        "s3:ListBucket",
        "s3:GetBucketVersioning"
      ],
      "Resource": "arn:aws:s3:::yufesta-tfstate"
    },
    {
      "Sid": "TerraformStateObjects",
      "Effect": "Allow",
      "Action": [
        "s3:GetObject",
        "s3:PutObject",
        "s3:DeleteObject"
      ],
      "Resource": "arn:aws:s3:::yufesta-tfstate/*"
    }
  ]
}
