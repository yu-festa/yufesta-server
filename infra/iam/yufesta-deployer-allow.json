{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "ReadOnlyDiscovery",
      "Effect": "Allow",
      "Action": [
        "ec2:Describe*",
        "elasticloadbalancing:Describe*",
        "ecs:Describe*",
        "ecs:List*",
        "ecr:Describe*",
        "ecr:List*",
        "ecr:GetAuthorizationToken",
        "rds:Describe*",
        "rds:ListTagsForResource",
        "logs:Describe*",
        "logs:ListTagsForResource",
        "cloudwatch:Describe*",
        "cloudwatch:ListTagsForResource",
        "sns:Get*",
        "sns:List*",
        "acm:Describe*",
        "acm:List*",
        "acm:GetCertificate",
        "route53:Get*",
        "route53:List*",
        "kms:DescribeKey",
        "kms:ListAliases",
        "ssm:DescribeParameters",
        "sts:GetCallerIdentity",
        "iam:Get*",
        "iam:List*"
      ],
      "Resource": "*"
    },
    {
      "Sid": "CreateAndManageProjectResources",
      "Effect": "Allow",
      "Action": [
        "ec2:*",
        "elasticloadbalancing:*",
        "ecs:*",
        "ecr:*",
        "rds:*",
        "logs:*",
        "cloudwatch:*",
        "sns:*",
        "acm:*"
      ],
      "Resource": "*"
    },
    {
      "Sid": "ProjectRolesOnly",
      "Effect": "Allow",
      "Action": [
        "iam:CreateRole",
        "iam:DeleteRole",
        "iam:UpdateRole",
        "iam:UpdateAssumeRolePolicy",
        "iam:TagRole",
        "iam:UntagRole",
        "iam:PassRole",
        "iam:AttachRolePolicy",
        "iam:DetachRolePolicy",
        "iam:PutRolePolicy",
        "iam:DeleteRolePolicy"
      ],
      "Resource": "arn:aws:iam::*:role/yufesta-*"
    },
    {
      "Sid": "ServiceLinkedRolesIfMissing",
      "Effect": "Allow",
      "Action": "iam:CreateServiceLinkedRole",
      "Resource": "*",
      "Condition": {
        "StringEquals": {
          "iam:AWSServiceName": [
            "ecs.amazonaws.com",
            "elasticloadbalancing.amazonaws.com",
            "rds.amazonaws.com"
          ]
        }
      }
    },
    {
      "Sid": "ProjectParametersOnly",
      "Effect": "Allow",
      "Action": [
        "ssm:PutParameter",
        "ssm:DeleteParameter",
        "ssm:GetParameter",
        "ssm:GetParameters",
        "ssm:GetParametersByPath",
        "ssm:AddTagsToResource",
        "ssm:RemoveTagsFromResource",
        "ssm:ListTagsForResource",
        "ssm:LabelParameterVersion"
      ],
      "Resource": "arn:aws:ssm:ap-northeast-2:*:parameter/yufesta/*"
    },
    {
      "Sid": "ProjectHostedZoneRecordsOnly",
      "Effect": "Allow",
      "Action": [
        "route53:ChangeResourceRecordSets",
        "route53:ListResourceRecordSets"
      ],
      "Resource": "arn:aws:route53:::hostedzone/Z03236913E7LJI3DHAKU3"
    },
    {
      "Sid": "TerraformStateBucket",
      "Effect": "Allow",
      "Action": [
        "s3:ListBucket",
        "s3:GetBucketVersioning"
      ],
      "Resource": "arn:aws:s3:::yufesta-tfstate"
    },
    {
      "Sid": "TerraformStateObjects",
      "Effect": "Allow",
      "Action": [
        "s3:GetObject",
        "s3:PutObject",
        "s3:DeleteObject"
      ],
      "Resource": "arn:aws:s3:::yufesta-tfstate/*"
    },
    {
      "Sid": "GithubOidcProviderReadOnly",
      "Effect": "Allow",
      "Action": [
        "iam:GetOpenIDConnectProvider",
        "iam:ListOpenIDConnectProviderTags"
      ],
      "Resource": "arn:aws:iam::*:oidc-provider/token.actions.githubusercontent.com"
    }
  ]
}
